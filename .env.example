# Anthropic API key — required for all benchmark runs
# Get yours at https://console.anthropic.com/
# WARNING: Copy this to .env and add your real key. NEVER commit .env — it is excluded by .gitignore.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional tuning knobs
# PROVING_GROUND_MODEL=claude-3-5-sonnet-20241022  # Pin the Claude model for reproducibility
# PROVING_GROUND_JUDGE_RUNS=5                       # Number of judge invocations per task (default: 5)
# PROVING_GROUND_MAX_WORKERS=4                      # Parallel task workers (default: 4)
